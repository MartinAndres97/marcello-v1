# Copie este archivo a .env y complete TODOS los valores. NO suba .env a GitHub.

# --- PostgreSQL ---
POSTGRES_USER=marcello
POSTGRES_DB=marcello
# Contraseña larga y aleatoria:  openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Aplicación ---
# Clave para firmar la sesión del panel (mínimo 32 caracteres):  openssl rand -hex 32
SECRET_KEY=
# Acceso al panel /admin
ADMIN_USER=admin
# Mínimo 10 caracteres. Se guarda solo en memoria como hash bcrypt.
ADMIN_PASSWORD=
# true si publica la app detrás de HTTPS (cookie de sesión solo por HTTPS)
COOKIE_SECURE=false
